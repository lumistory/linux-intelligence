{
  "hook_binary": "crates/li-hook",
  "protocol_schema_version": 1,
  "values_from": "experiments/00-a-shell-hooks/capabilities/*.json, copied verbatim. `partial:` and `unknown` values are NOT upgraded (P1-19); anything this batch did not measure stays exactly as 0-A left it. Only the fields a consumer must act on are repeated here; the full record is the 0-A file.",
  "not_measured_here": [
    "monotonic_clock: absent in all three; ts_mono_ns is 0 and the daemon stamps it",
    "background_completion: never observed",
    "fish dead-sink resilience: tests/no_daemon.rs shows the shell alive, but the record stays `unknown` until fish is re-measured deliberately"
  ],
  "shells": {
    "bash": {
      "adapter_file": "adapters/bash.sh",
      "hook_combination": "PROMPT_COMMAND + history 1 (finish), PS0 counter (start tick)",
      "command_text_multiline": "partial:joined_with_single_space_backslash_removed",
      "start_time": "partial:wall_clock_only_no_monotonic",
      "exit_status": true,
      "duration": "partial:wall_clock_microseconds_from_PS0",
      "ctrl_c_exit_status": 130,
      "internal_script_commands": false,
      "event_on_kill9": false,
      "unclosed_event_on_kill9": false,
      "fires_in_noninteractive": false,
      "sink_can_be_unix_socket_redirection": false,
      "sink_requires_launcher_supplied_fd": true,
      "monotonic_clock": false,
      "per_command_fork_required": 1,
      "hook_can_kill_shell_if_sink_dies": "true_without_trap_guard",
      "unknown_when_history_dropped": "the line is reported with command:null and command_text_source:unavailable, never guessed",
      "command_text": true,
      "command_text_source": "history 1",
      "end_time": true,
      "cwd": true,
      "pid": true,
      "sid": true,
      "new_session": true,
      "multi_line": "partial:backslash_continuation_joined_into_one_line",
      "pipelines": "single-event",
      "builtins": true,
      "functions": "single-event:only_the_typed_call_is_reported",
      "aliases": "true:alias_name_is_reported_not_expansion",
      "background": "partial:the_&_line_is_reported_immediately_completion_not_observed",
      "subshell": "single-event:the_whole_line_is_reported_once",
      "ctrl_c_reported": true,
      "fires_in_dash_c": false
    },
    "zsh": {
      "adapter_file": "adapters/zsh.zsh",
      "hook_combination": "preexec + precmd, appended to the raw *_functions arrays",
      "command_text_multiline": "true:newlines_preserved_verbatim",
      "start_time": "partial:wall_clock_only_no_monotonic",
      "exit_status": true,
      "duration": "partial:wall_clock_microseconds_from_preexec",
      "ctrl_c_exit_status": 130,
      "internal_script_commands": false,
      "event_on_kill9": false,
      "unclosed_event_on_kill9": false,
      "fires_in_noninteractive": false,
      "sink_can_be_unix_socket_redirection": false,
      "sink_requires_launcher_supplied_fd": true,
      "monotonic_clock": false,
      "per_command_fork_required": 0,
      "hook_can_kill_shell_if_sink_dies": "true_without_guard",
      "zsh_can_dial_unix_socket_via_zsocket": "unknown:not_exercised",
      "command_text": true,
      "command_text_source": "preexec $1",
      "end_time": true,
      "cwd": true,
      "pid": true,
      "sid": true,
      "new_session": true,
      "multi_line": "true:literal_newlines_kept",
      "pipelines": "single-event",
      "builtins": true,
      "functions": "single-event:only_the_typed_call_is_reported",
      "aliases": "true:alias_name_is_reported_not_expansion",
      "background": "partial:the_&_line_is_reported_immediately_completion_not_observed",
      "subshell": "single-event:the_whole_line_is_reported_once",
      "ctrl_c_reported": true,
      "fires_in_dash_c": false,
      "needs_module_path_fix_when_unpacked": true,
      "needs_fpath_fix_for_add_zsh_hook": true
    },
    "fish": {
      "adapter_file": "adapters/fish.fish",
      "hook_combination": "fish_preexec + fish_postexec (postexec authoritative)",
      "command_text_multiline": "partial:backslash_continuation_concatenated_without_separator",
      "start_time": "partial:wall_clock_via_date_fork_or_postexec_only",
      "exit_status": true,
      "duration": "true:CMD_DURATION_provided_by_fish",
      "ctrl_c_exit_status": 130,
      "internal_script_commands": false,
      "event_on_kill9": false,
      "unclosed_event_on_kill9": false,
      "fires_in_noninteractive": false,
      "sink_can_be_unix_socket_redirection": false,
      "sink_requires_launcher_supplied_fd": true,
      "monotonic_clock": false,
      "per_command_fork_required": 1,
      "reports_exit_keyword": true,
      "needs_term_dumb_under_bare_pty": true,
      "hook_can_kill_shell_if_sink_dies": "unknown:fish_is_not_killed_by_SIGPIPE_in_this_setup_untested",
      "command_text": true,
      "command_text_source": "fish_postexec $argv[1]",
      "end_time": true,
      "cwd": true,
      "pid": true,
      "sid": true,
      "new_session": true,
      "multi_line": "partial:continuation_joined_as_echo_t02-one\\two",
      "pipelines": "single-event",
      "builtins": true,
      "functions": "single-event:only_the_typed_call_is_reported",
      "aliases": "true:alias_name_is_reported_not_expansion",
      "background": "partial:the_&_line_is_reported_immediately_completion_not_observed",
      "subshell": "single-event:begin/end_reported_once",
      "ctrl_c_reported": true,
      "fires_in_dash_c": false
    }
  }
}
