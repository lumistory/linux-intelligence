# bash-ps0-vs-promptcommand  (generated by harness/probes.py)
Q: PS0 expands before the command; which status/command does it see?

--- terminal ---
=== typed: echo one ===
⟦LI-P⟧ PS0='[PS0 rc=$? cmd={$BASH_COMMAND}]\n'
⟦LI-P⟧ PROMPT_COMMAND='printf "PC rc=%s hist=[%s]\n" "$?" "$(HISTTIMEFORMAT= history 1)" >&3'
[PS0 rc=0 cmd={PS0='[PS0 rc=$? cmd={$BASH_COMMAND}]\n'}]
⟦LI-P⟧ echo one
[PS0 rc=0 cmd={PROMPT_COMMAND='printf "PC rc=%s hist=[%s]\n" "$?" "$(HISTTIMEFORMAT= history 1)" >&3'}]
one
⟦LI-P⟧
=== typed: false ===
⟦LI-P⟧ PS0='[PS0 rc=$? cmd={$BASH_COMMAND}]\n'
⟦LI-P⟧ PROMPT_COMMAND='printf "PC rc=%s hist=[%s]\n" "$?" "$(HISTTIMEFORMAT= history 1)" >&3'
[PS0 rc=0 cmd={PS0='[PS0 rc=$? cmd={$BASH_COMMAND}]\n'}]
⟦LI-P⟧ echo one
[PS0 rc=0 cmd={PROMPT_COMMAND='printf "PC rc=%s hist=[%s]\n" "$?" "$(HISTTIMEFORMAT= history 1)" >&3'}]
one
⟦LI-P⟧ false
[PS0 rc=0 cmd={echo one}]
⟦LI-P⟧
=== typed: echo two ===
⟦LI-P⟧ PS0='[PS0 rc=$? cmd={$BASH_COMMAND}]\n'
⟦LI-P⟧ PROMPT_COMMAND='printf "PC rc=%s hist=[%s]\n" "$?" "$(HISTTIMEFORMAT= history 1)" >&3'
[PS0 rc=0 cmd={PS0='[PS0 rc=$? cmd={$BASH_COMMAND}]\n'}]
⟦LI-P⟧ echo one
[PS0 rc=0 cmd={PROMPT_COMMAND='printf "PC rc=%s hist=[%s]\n" "$?" "$(HISTTIMEFORMAT= history 1)" >&3'}]
one
⟦LI-P⟧ false
[PS0 rc=0 cmd={echo one}]
⟦LI-P⟧ echo two
[PS0 rc=1 cmd={false}]
two
⟦LI-P⟧

--- FD 3 events ---
PC rc=0 hist=[    2  PROMPT_COMMAND='printf "PC rc=%s hist=[%s]\n" "$?" "$(HISTTIMEFORMAT= history 1)" >&3']
PC rc=0 hist=[    3  echo one]
PC rc=1 hist=[    4  false]
PC rc=0 hist=[    5  echo two]

CONCLUSION: PS0 lags exactly one command (its rc/cmd belong to the
previous line); PROMPT_COMMAND carries the true status of the line that
just ran, and `history 1` carries that line's full text.
