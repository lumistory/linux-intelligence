# T4 — 100 concurrent clients x 5 requests each, one shared
# append-only audit file. Invariants:
#   A1 audit lines            == requests + 2 lifecycle records
#   A2 sequence numbers       exactly 1..N, no gap, no duplicate
#   A3 sequence order        == file order (O_APPEND + one locked write)
#   A4 every line             is a complete, parseable JSON object
#   A5 file mode              is 0600

{"case":"storm_summary","client_errors":0,"clients":100,"elapsed_ms":5,"requests_per_client":5,"requests_sent":500,"throughput_per_s":96883}

audit_lines=601
request_served_records=500
requests_sent=500
file_mode=600
file_uid=1000
parent_dir_mode=700

## A2/A4: sequence density and JSON validity
parsed_records=601 malformed_lines=0
sequence_min=1 sequence_max=601 count=601
sequence_dense_and_in_file_order=True
sequence_duplicates=0
types={"ConnectionClosed": 100, "HelperStarted": 1, "RequestServed": 500}
