# T1c — is (pid,starttime) a unique process identity? starttime has
# CLK_TCK granularity, so two distinct processes created inside one tick
# would share both fields. Forced reuse makes this deterministic.
\$ unshare -Urpf --mount-proc credprobe same-tick --pid 4242 --trials 20

