# T2 — what uid 0 inside `unshare -Ur` actually holds.
# Host uid is 1000; inside the namespace uid 0 maps to it.

## (a) identity and mapping inside the namespace
\$ unshare -Ur sh -c 'cat /proc/self/uid_map; id'
         0       1000          1
uid=0(root) gid=0(root) 组=0(root),65534(nobody)

## (b) can namespace-root read a host root-only file?
\$ cat /etc/shadow                  # as the host user
  READ_DENIED (EACCES)
\$ unshare -Ur cat /etc/shadow      # as namespace root
  READ_DENIED (EACCES)

## (c) can namespace-root read a file owned by a DIFFERENT uid?
# A second uid from /etc/subuid (host 100000) is mapped into a fresh
# namespace; it creates a 0600 file, then namespace-root tries to read it.
# Both processes belong to the same host user, so this isolates kernel
# ownership checks from the host user's own rights.
sh: 行 1: /tmp/li-phase0-0g-f8uh0T/t2/other-uid.txt: 权限不够
chmod: 无法访问 '/tmp/li-phase0-0g-f8uh0T/t2/other-uid.txt': 权限不够
  uid0 (ns root) read -> READ_DENIED
  uid5 (owner)   read -> READ_DENIED
  file host owner    -> stat: 对 '/tmp/li-phase0-0g-f8uh0T/t2/other-uid.txt' 调用 statx 失败: 没有那个文件或目录
  subuid mapping unavailable

## (d) can namespace-root mount a tmpfs? (expected yes, but namespace-local)
\$ unshare -Urm sh -c 'mount -t tmpfs tmpfs <dir>'
  MOUNT_OK
  write_inside_ns=OK
  visible_in_ns=x 
  filesystem=tmpfs
  host_view_after_ns_exit=GONE (the mount died with its namespace)

## (e) what does setuid() inside the namespace mean? Only mapped uids work.
\$ unshare -Ur sh -c 'setpriv --reuid=N ... true'
  setuid(0) -> DENIED (uid not mapped in this ns)
  setuid(65534) -> DENIED (uid not mapped in this ns)
  setuid(1000) -> DENIED (uid not mapped in this ns)

## (f) can namespace-root signal a host root process?
\$ unshare -Ur sh -c 'kill -0 1'
  SIGNAL_DENIED errno=1

## (g) host-side ownership of a file created by namespace-root
\$ unshare -Ur sh -c 'echo x > f'; stat f   # from the host
  host_stat: uid=1000 gid=1000 mode=644 name=/tmp/li-phase0-0g-f8uh0T/t2/created-by-nsroot.txt

## (h) capability set inside the namespace
\$ unshare -Ur capsh --print | head -6
  Current: =ep
  Bounding set =cap_chown,cap_dac_override,cap_dac_read_search,cap_fowner,cap_fsetid,cap_kill,cap_setgid,cap_setuid,cap_setpcap,cap_linux_immutable,cap_net_bind_service,cap_net_broadcast,cap_net_admin,cap_net_raw,cap_ipc_lock,cap_ipc_owner,cap_sys_module,cap_sys_rawio,cap_sys_chroot,cap_sys_ptrace,cap_sys_pacct,cap_sys_admin,cap_sys_boot,cap_sys_nice,cap_sys_resource,cap_sys_time,cap_sys_tty_config,cap_mknod,cap_lease,cap_audit_write,cap_audit_control,cap_setfcap,cap_mac_override,cap_mac_admin,cap_syslog,cap_wake_alarm,cap_block_suspend,cap_audit_read,cap_perfmon,cap_bpf,cap_checkpoint_restore
  Ambient set =
  Current IAB: 
  Securebits: 00/0x0/1'b0 (no-new-privs=0)
   secure-noroot: no (unlocked)

## (i) can namespace-root write to /etc? (must not touch the host)
\$ unshare -Ur sh -c 'touch /etc/li-0g-should-not-exist'
  WRITE_DENIED (EACCES/EROFS as expected)
