# T3 — the entire attacker-reachable surface of the helper.
# root=/tmp/li-phase0-0g-Hm2fPu/t3root
# allow_uid=1000

## file modes: two independent gates
  socket mode=600 uid=1000 gid=1000
  audit  mode=600 uid=1000 gid=1000

## T3a  path escapes: lexical traversal and symlink escapes
##      both layers must refuse; openat2 also refuses symlinks INSIDE root
  ../../etc/shadow           -> {"ok":false,"opcode":"StatPath","code":"path_escape","message":"path escapes the permitted root"}
  /etc/shadow                -> {"ok":false,"opcode":"StatPath","code":"path_escape","message":"path escapes the permitted root"}
  ../etc/shadow              -> {"ok":false,"opcode":"StatPath","code":"path_escape","message":"path escapes the permitted root"}
  sub/../../etc/shadow       -> {"ok":false,"opcode":"StatPath","code":"path_escape","message":"path escapes the permitted root"}
  link-shadow-abs            -> {"ok":false,"opcode":"StatPath","code":"path_escape","message":"path escapes the permitted root"}
  link-shadow-rel            -> {"ok":false,"opcode":"StatPath","code":"path_escape","message":"path escapes the permitted root"}
  link-rootdir               -> {"ok":false,"opcode":"StatPath","code":"path_escape","message":"path escapes the permitted root"}
  link-etc                   -> {"ok":false,"opcode":"StatPath","code":"path_escape","message":"path escapes the permitted root"}

## T3b  shell metacharacters in a path argument
  a;id                       -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  a|id                       -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  a&id                       -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  $(id)                      -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  `id`                       -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  a b                        -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  a"b                        -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  a'b                        -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  a>b                        -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  *                          -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  a\b                        -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}
  embedded newline           -> {"ok":false,"opcode":"StatPath","code":"path_invalid","message":"path rejected by the lexical whitelist"}

## T3c  opcode confusion
  numeric unknown                -> {"ok":false,"opcode":"<none>","code":"unknown_opcode","message":"unknown opcode 99"}
  string as command name         -> {"ok":false,"opcode":"<none>","code":"bad_opcode","message":"opcode must be numeric, not a string"}
  negative                       -> {"ok":false,"opcode":"<none>","code":"bad_opcode","message":"opcode must be a JSON number"}
  fractional                     -> {"ok":false,"opcode":"<none>","code":"bad_opcode","message":"opcode must be a JSON number"}
  recognised but not implemented -> {"ok":false,"opcode":"BtrfsSnapshot","code":"not_implemented_by_design","message":"opcode exists in the table but is intentionally not implemented"}
  undeclared argument            -> {"ok":false,"opcode":"Describe","code":"arg_unexpected","message":"Describe takes no arguments"}
  args is an array               -> {"ok":false,"opcode":"StatPath","code":"arg_unexpected","message":"only `path` is accepted for this opcode"}
  not JSON                       -> {"ok":false,"opcode":"<frame>","code":"bad_frame","message":"not a JSON request object"}

