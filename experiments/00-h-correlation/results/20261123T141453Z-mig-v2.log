--- upgrade v1 -> v2 on the populated database ---
journal_mode=wal synchronous=1 busy_timeout_ms=5000 foreign_keys=on
schema_version: 1 -> 2, applied=[2]
integrity_check=ok
foreign_key_violations=0
tables:
  adapter_registry
  approvals
  checkpoints
  event_operations
  event_relations
  events
  evidence
  operations
  processes
  recovery_plans
  schema_version
  sessions
indexes:
  idx_approvals_plan
  idx_event_operations_op
  idx_events_dedup
  idx_events_fingerprint
  idx_events_process
  idx_events_session_seq
  idx_events_time
  idx_events_type_time
  idx_evidence_relation
  idx_operations_session
  idx_processes_key
  idx_processes_session
  idx_relations_from
  idx_relations_to

--- verify after upgrade ---
schema_version=2
events columns: event_id, schema_version, source, session_id, process_row_id, sequence, ts_mono_ns, ts_wall, type, type_class, payload, evidence_status, dedup_group, duplicate_of, redaction_digest, ingested_mono_ns, command_text, redaction_rules
sessions columns: session_id, parent_session, adapter, adapter_version, shell_pid, started_wall, started_mono_ns, ended_wall, ended_mono_ns, cwd, host, capability_json
events=5000 sessions=2
  v1 0001_init checksum=546433d699109e0d
  v2 0002_add_event_redaction checksum=c03348a47a47c7a6
integrity_check=ok
